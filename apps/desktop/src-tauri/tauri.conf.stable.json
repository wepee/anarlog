{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackMushi",
  "mainBinaryName": "anarlog",
  "identifier": "com.blackmushi.stable",
  "bundle": {
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.icns",
      "icons/stable/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/AppIcon.icns": "resources/stable-dark/AppIcon.icns"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["anarlog", "hyprnote"] }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/wepee/anarlog/releases/latest/download/latest.json"
      ]
    }
  }
}
